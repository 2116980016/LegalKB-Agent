# 复制为 .env 后填写；.env 已被 gitignore
# 不配置也能跑：默认 LLM_PROVIDER=echo（离线桩，只用于链路验证与 CI）

# ---------- LLM ----------
# echo = 离线确定性桩；dashscope = 走 OpenAI 兼容接口
LLM_PROVIDER=echo
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ---------- 向量 ----------
# hash = 离线哈希向量（IDF 加权，零依赖）
# bge  = 本地模型 BAAI/bge-small-zh-v1.5（需要 torch + 模型权重）
# api  = 调用 OpenAI 兼容的 /embeddings（DashScope text-embedding-v3 等，需要 Key）
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=512
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VECTOR_BACKEND=numpy

# 用 api 向量时把下面两行改成（dim 要一起改）：
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_DIM=1024
#   EMBEDDING_MODEL=text-embedding-v3

# ---------- 检索 ----------
CHILD_SIZE=150
CHILD_OVERLAP=60
K_VEC=10
K_BM25=10
TOP_N=5
RERANKER=overlap
RRF_K=60
STRATEGY=hybrid_rerank
WEIGHT_VECTOR=0.8
WEIGHT_BM25=0.2

# ---------- 服务 ----------
# 这是服务自己的访问密码（不是模型 Key），留空 = 不鉴权；生产环境务必设置
API_KEY=
LOG_LEVEL=INFO
